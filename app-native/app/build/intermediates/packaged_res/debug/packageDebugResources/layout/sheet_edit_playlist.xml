<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:paddingHorizontal="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#666666" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="Редактировать плейлист"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_playlist_title"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_login_input"
        android:hint="Название плейлиста"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingHorizontal="16dp"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:singleLine="true"
        android:autofillHints="" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="Видимость"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_folder_public"
            android:contentDescription=""
            app:tint="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_public"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Публичный (виден всем)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:buttonTint="@color/accent_red" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_folder_private"
            android:contentDescription=""
            app:tint="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_private"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Личный (только для вас)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:buttonTint="@color/accent_red" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_playlist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Сохранить"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        app:backgroundTint="@color/accent_red"
        app:cornerRadius="12dp"
        app:rippleColor="#33FFFFFF" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_delete_playlist"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Удалить плейлист"
        android:textSize="15sp"
        android:textColor="@color/accent_red"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        app:backgroundTint="@color/card_bg"
        app:strokeColor="@color/accent_red"
        app:strokeWidth="1dp"
        app:cornerRadius="12dp"
        app:rippleColor="#22CF001F" />

    <ProgressBar
        android:id="@+id/edit_progress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/accent_red"
        android:visibility="gone" />

</LinearLayout>
