<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@+id/player_frame"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:use_controller="false"
            app:show_buffering="when_playing"
            app:resize_mode="fit"
            app:surface_type="texture_view" />

        <!-- ПРЕВЬЮ ДЛЯ АУДИО-РЕЖИМА (показывается вместо PlayerView) -->
        <ImageView
            android:id="@+id/audio_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#000000"
            android:visibility="gone"
            android:contentDescription="Превью" />

        <!-- ЗАТЕМНЕНИЕ ПРЕВЬЮ (только в аудио-режиме) -->
        <View
            android:id="@+id/audio_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone" />

        <!-- ИКОНКА АУДИО (только в аудио-режиме, центр) -->
        <ImageView
            android:id="@+id/audio_mode_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_download_audio"
            android:contentDescription="Аудио-режим"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <ru.asmr1.app.player.RippleView
            android:id="@+id/ripple_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/seek_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_seek_indicator"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:visibility="gone"
            android:alpha="0">

            <TextView
                android:id="@+id/seek_indicator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="+10 сек" />

        </LinearLayout>

        <ru.asmr1.app.player.VideoProgressBar
            android:id="@+id/progress_bar"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

        <View
            android:id="@+id/thumb_view"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_thumb_circle"
            android:visibility="gone"
            android:elevation="10dp" />

        <FrameLayout
            android:id="@+id/controls_layer"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/dim_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#88000000"
                android:alpha="0.75" />

            <ImageButton
                android:id="@+id/btn_minimize"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_player_minimize"
                android:contentDescription="Свернуть"
                android:scaleType="centerInside"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_player_close"
                android:contentDescription="Закрыть"
                android:scaleType="centerInside"
                app:tint="#FFFFFF" />

            <FrameLayout
                android:id="@+id/btn_prev_wrap"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="48dp"
                android:background="@drawable/bg_player_circle">

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_player_prev"
                    android:contentDescription="Предыдущее"
                    android:scaleType="centerInside"
                    android:padding="11dp"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_play_pause_wrap"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_player_circle">

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_player_play"
                    android:contentDescription="Play/Pause"
                    android:scaleType="centerInside"
                    android:padding="18dp"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_next_wrap"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="48dp"
                android:background="@drawable/bg_player_circle">

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_player_next"
                    android:contentDescription="Следующее"
                    android:scaleType="centerInside"
                    android:padding="11dp"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_fullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_player_fullscreen"
                android:contentDescription="Fullscreen"
                android:scaleType="centerInside"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/time_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:text="00:00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginHorizontal="3dp"
                    android:text="/" />

                <TextView
                    android:id="@+id/total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:text="00:00" />

            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

</FrameLayout>
