<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:minHeight="600dp">

            <!-- Кнопка закрытия сверху справа -->
            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_player_close"
                android:contentDescription="Закрыть"
                android:scaleType="centerInside"
                app:tint="@color/text_secondary"
                android:padding="8dp" />

            <!-- Верхний отступ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="20dp" />

            <!-- Логотип (без рамки) -->
            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"
                android:src="@drawable/app_logo"
                android:contentDescription="ASMR1"
                android:scaleType="fitCenter" />

            <!-- Подпись -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ASMR1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.3"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <!-- Заголовок -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Создать аккаунт"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Зарегистрируйтесь за 10 секунд"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Поле: Логин -->
            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_login_input"
                android:hint="Логин (минимум 3 символа)"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:autofillHints="username" />

            <!-- Поле: Email -->
            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_login_input"
                android:hint="Email"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:autofillHints="emailAddress" />

            <!-- Поле: Пароль -->
            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_login_input"
                android:hint="Пароль (минимум 6 символов)"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:inputType="textPassword"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:autofillHints="newPassword" />

            <!-- Капча: пример + поле ввода + обновить -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_captcha_question"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:text="Загрузка..."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/et_captcha_answer"
                    android:layout_width="100dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="?"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="number"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:maxLength="5" />

                <ImageButton
                    android:id="@+id/btn_refresh_captcha"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_player_close"
                    android:contentDescription="Обновить капчу"
                    android:scaleType="centerInside"
                    app:tint="@color/text_secondary"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Прогресс (скрыт) -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/accent_red"
                android:layout_marginBottom="16dp" />

            <!-- Кнопка ЗАРЕГИСТРИРОВАТЬСЯ (красная) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Зарегистрироваться"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="12dp"
                app:rippleColor="#33FFFFFF" />

            <!-- Кнопка НАЗАД К ВХОДУ (серая с бордером) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_login"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Уже есть аккаунт"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:layout_marginBottom="24dp"
                app:backgroundTint="@color/card_bg"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:rippleColor="#22FFFFFF" />

            <!-- Подсказка -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Регистрируясь, вы соглашаетесь с правилами сервиса"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:gravity="center" />

            <!-- Нижний отступ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="20dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
