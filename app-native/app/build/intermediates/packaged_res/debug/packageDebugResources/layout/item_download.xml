<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingBottom="16dp">

    <!-- Превью + иконка типа -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/card_bg"
            android:contentDescription="Превью" />

        <!-- Иконка типа (видео/аудио) в углу -->
        <ImageView
            android:id="@+id/type_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_video_badge"
            android:padding="6dp"
            android:src="@drawable/ic_download_video"
            android:contentDescription="Тип"
            app:tint="#FFFFFF" />

        <!-- Размер файла снизу справа -->
        <TextView
            android:id="@+id/size_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_video_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="0 МБ"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </FrameLayout>

    <!-- Название + автор -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:gravity="top">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/author_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/card_bg"
            android:contentDescription="Аватар"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/author_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/download_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Кнопка удалить -->
        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download_delete"
            android:contentDescription="Удалить"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="@color/accent_red" />

    </LinearLayout>

</LinearLayout>
