<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#666666" />

    <!-- ===== АУДИО ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/menu_download_audio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/menu_download_audio_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Скачать только аудио"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_download_audio"
                android:contentDescription="Аудио"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/menu_delete_audio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download_delete"
            android:contentDescription="Удалить аудио"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:visibility="gone"
            app:tint="@color/accent_red" />
    </LinearLayout>

    <!-- ===== ВИДЕО ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/menu_download_video"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/menu_download_video_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Скачать видео"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_download_video"
                android:contentDescription="Видео"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/menu_delete_video"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_download_delete"
            android:contentDescription="Удалить видео"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:visibility="gone"
            app:tint="@color/accent_red" />
    </LinearLayout>

    <!-- ===== ОТМЕНА ===== -->
    <TextView
        android:id="@+id/menu_download_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Отмена"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:fontFamily="sans-serif" />

</LinearLayout>
