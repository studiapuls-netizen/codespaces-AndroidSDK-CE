<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#666666" />

    <TextView
        android:id="@+id/menu_hide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Не интересно"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/menu_hide_channel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Не рекомендовать канал"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/menu_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Сохранить в плейлист"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/menu_report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Пожаловаться"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/menu_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Отмена"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

</LinearLayout>
