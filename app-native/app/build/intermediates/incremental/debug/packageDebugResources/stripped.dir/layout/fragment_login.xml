<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:minHeight="600dp">

            <!-- Кнопка закрытия сверху справа -->
            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_player_close"
                android:contentDescription="Закрыть"
                android:scaleType="centerInside"
                app:tint="@color/text_secondary"
                android:padding="8dp" />

            <!-- Верхний отступ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="40dp" />

            <!-- Логотип (без рамки) -->
            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"
                android:src="@drawable/app_logo"
                android:contentDescription="ASMR1"
                android:scaleType="fitCenter" />

            <!-- Подпись -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ASMR1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.3"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <!-- Приветствие -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="С возвращением"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Войдите чтобы продолжить"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layout_marginBottom="40dp" />

            <!-- Поле: Логин -->
            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_login_input"
                android:hint="Логин или почта"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:autofillHints="username" />

            <!-- Поле: Пароль -->
            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_login_input"
                android:hint="Пароль"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:inputType="textPassword"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:autofillHints="password" />

            <!-- Прогресс (скрыт) -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/accent_red"
                android:layout_marginBottom="16dp" />

            <!-- Кнопка ВОЙТИ (красная) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Войти"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="12dp"
                app:rippleColor="#33FFFFFF" />

            <!-- Кнопка РЕГИСТРАЦИЯ (серая с бордером) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Создать аккаунт"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:layout_marginBottom="24dp"
                app:backgroundTint="@color/card_bg"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:rippleColor="#22FFFFFF" />

            <!-- Гость (текстовая ссылка) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guest"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Продолжить как гость"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:textAllCaps="false"
                android:fontFamily="sans-serif" />

            <!-- Нижний отступ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="20dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
