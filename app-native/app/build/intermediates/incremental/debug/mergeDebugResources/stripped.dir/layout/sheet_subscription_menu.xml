<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#666666" />

    <TextView
        android:id="@+id/subs_menu_notify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Получать уведомления"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/subs_menu_mute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Не получать уведомления"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/subs_menu_unsubscribe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        android:text="Отписаться"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

</LinearLayout>
